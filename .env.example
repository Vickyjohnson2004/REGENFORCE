# ============================================================================
# REGENFORCE MCP server configuration
# ============================================================================

# --- HTTP ---
PORT=4010

# Disable Context JWT verification locally for smoke tests.
# Set to "true" in production (Railway) so paid tool calls are verified.
CONTEXT_AUTH_ENABLED=false

# --- PostgreSQL (Railway: use DATABASE_URL variable reference) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/regenforce
# When true, skip TLS cert verification (Railway internal Postgres uses a self-signed cert).
DATABASE_SSL_STRICT=false

# --- Redis (optional: falls back to in-memory LRU if REDIS_URL is empty) ---
REDIS_URL=
REDIS_TTL_SECONDS=900

# --- Ingestion ---
# Set to "true" to run full ingestion once on server startup (useful for first deploy).
INGEST_ON_STARTUP=false
# Cron schedule for the background ingester. Default: every 6 hours at :07.
INGEST_CRON="7 */6 * * *"
# Per-source opt-outs (comma separated: SEC,CFPB,FTC,FINRA,FINCEN,OCC).
INGEST_DISABLE=""

# --- FTC API key (free from data.gov) ---
# https://api.data.gov/signup/
DATA_GOV_API_KEY=

# --- Admin ingestion trigger ---
# Set to a random string to enable POST /admin/ingest (leave empty to disable).
ADMIN_INGEST_TOKEN=

# --- Logging ---
LOG_LEVEL=info
